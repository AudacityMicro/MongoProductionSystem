MPS_HOST=0.0.0.0
MPS_PORT=8000
MPS_LOG_LEVEL=info
# MPS_DATABASE_URL=sqlite:///C:/path/to/mongo-production.db
MPS_BACKUP_ENABLED=false
MPS_BACKUP_DIRECTORY=runtime/backups
MPS_BACKUP_INTERVAL_SECONDS=900
MPS_BACKUP_DEBOUNCE_SECONDS=15
# Customer scheduler API is disabled until a strong key is supplied. Set
# browser origins only when a browser-based customer site calls this API.
# MPS_CUSTOMER_API_KEY=replace-with-a-long-random-secret
# MPS_CUSTOMER_API_ORIGINS=https://customers.example.com
